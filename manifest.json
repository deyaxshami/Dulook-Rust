{
  "schemaVersion": 1,
  "id": "karem.dulook",
  "name": "Dulook",
  "version": "3.0.0",
  "author": "Karem",
  "description": "Local prayer times and bilingual Hadith reminders",
  "license": "MIT",
  "repository": "https://github.com/Karem-Shami/Dulook",
  "kinds": ["service", "bar-widget"],
  "entryPoints": { "service": "Service.qml", "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Dulook",
    "description": "Local prayer times, notifications, Adhan audio, and Hadith",
    "category": "Info",
    "defaultSection": "center",
    "allowMultiple": false,
    "defaults": {
      "language": "en",
      "calendarPath": "data/prayer-times-2026-nordhorn.csv",
      "notificationsEnabled": true,
      "prayerTimeNotificationsEnabled": true,
      "prayerRemindersEnabled": true,
      "lastThirdReminderEnabled": true,
      "notifyFajr": true,
      "notifyDhuhr": true,
      "notifyAsr": true,
      "notifyMaghrib": true,
      "notifyIsha": true,
      "remindFajr": true,
      "remindDhuhr": true,
      "remindAsr": true,
      "remindMaghrib": true,
      "remindIsha": true,
      "bypassDnd": false,
      "soundEnabled": true,
      "soundPath": "adans/adan_01.mp3",
      "soundVolume": 80,
      "arabicUiFont": "Noto Sans Arabic",
      "arabicHadithFont": "Noto Naskh Arabic"
    },
    "schema": [
      { "key": "language", "type": "enum", "label": "Language", "options": ["en", "ar"], "defaultValue": "en" },
      { "key": "calendarPath", "type": "path", "label": "Prayer calendar CSV", "defaultValue": "data/prayer-times-2026-nordhorn.csv" },
      { "key": "prayerTimeNotificationsEnabled", "type": "boolean", "label": "Prayer-time notifications", "defaultValue": true },
      { "key": "prayerRemindersEnabled", "type": "boolean", "label": "15-minute reminders", "defaultValue": true },
      { "key": "lastThirdReminderEnabled", "type": "boolean", "label": "Last-third reminder", "defaultValue": true },
      { "key": "notifyFajr", "type": "boolean", "label": "Prayer-time notification for Fajr", "defaultValue": true },
      { "key": "notifyDhuhr", "type": "boolean", "label": "Prayer-time notification for Dhuhr", "defaultValue": true },
      { "key": "notifyAsr", "type": "boolean", "label": "Prayer-time notification for Asr", "defaultValue": true },
      { "key": "notifyMaghrib", "type": "boolean", "label": "Prayer-time notification for Maghrib", "defaultValue": true },
      { "key": "notifyIsha", "type": "boolean", "label": "Prayer-time notification for Isha", "defaultValue": true },
      { "key": "remindFajr", "type": "boolean", "label": "15-minute reminder for Fajr", "defaultValue": true },
      { "key": "remindDhuhr", "type": "boolean", "label": "15-minute reminder for Dhuhr", "defaultValue": true },
      { "key": "remindAsr", "type": "boolean", "label": "15-minute reminder for Asr", "defaultValue": true },
      { "key": "remindMaghrib", "type": "boolean", "label": "15-minute reminder for Maghrib", "defaultValue": true },
      { "key": "remindIsha", "type": "boolean", "label": "15-minute reminder for Isha", "defaultValue": true },
      { "key": "bypassDnd", "type": "boolean", "label": "Bypass Do Not Disturb", "defaultValue": false },
      { "key": "soundEnabled", "type": "boolean", "label": "Adhan sound", "defaultValue": true },
      { "key": "soundPath", "type": "path", "label": "Adhan MP3", "defaultValue": "adans/adan_01.mp3" },
      { "key": "soundVolume", "type": "integer", "label": "Adhan volume", "min": 0, "max": 100, "step": 5, "defaultValue": 80 },
      { "key": "arabicUiFont", "type": "string", "label": "Arabic UI font", "defaultValue": "Noto Sans Arabic" },
      { "key": "arabicHadithFont", "type": "string", "label": "Arabic Hadith font", "defaultValue": "Noto Naskh Arabic" }
    ]
  }
}
